# ========================================================
# DevPath - Configurações de Ambiente (.env)
# ========================================================
# Para configurar seu ambiente local, faça uma cópia deste arquivo:
#   cp .env.example .env
#
# Como a aplicação é 100% local e mono-usuário com SQLite,
# todas as variáveis possuem valores padrão seguros e são OPCIONAIS.
# ========================================================

# Porta HTTP do servidor backend (Padrão: 3000)
PORT=3000

# Interface de rede do servidor backend (Padrão: 0.0.0.0)
HOST=127.0.0.1

# Ambiente de execução: 'development' ou 'production' (Padrão: development)
NODE_ENV=development

# Caminho do banco de dados SQLite local (Padrão: ./data/studyflow.sqlite)
DATABASE_PATH=./data/studyflow.sqlite

